FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY trainer-api /build/trainer-api
COPY katib-api /build/katib-api
COPY sdk /build/sdk
RUN pip install --no-cache-dir /build/trainer-api /build/katib-api /build/sdk
COPY training.py /app/training.py
USER 65532:65532
WORKDIR /app
ENTRYPOINT ["python", "/app/training.py"]
