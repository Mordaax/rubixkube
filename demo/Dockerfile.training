# The launcher stages its own Linux Rust executable into this build context.
FROM gcr.io/distroless/cc-debian12@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --chmod=0555 optimizationjob /app/optimizationjob
USER 65532:65532
WORKDIR /app
ENTRYPOINT ["/app/optimizationjob", "train"]
